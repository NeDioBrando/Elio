{
  "manifest_version": 3,
  "name": "synerixcode × Roblox Studio & AgentScript",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "description": "synerixcode connects supported AI chats to Roblox Studio and local AgentScript with animation, VFX, Luau knowledge, web research, and project tools.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
