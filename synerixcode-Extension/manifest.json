    "https://*.notion.com/*",
    "https://app.clickup.com/*",
    "https://vani.ai/*",
    "https://www.vani.ai/*",
    "https://c.vani.ai/*"
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://* http://* ws://127.0.0.1:* http://127.0.0.1:* http://localhost:* https://ollama.com https://*.ollama.com"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui/*.jpg",
        "icon.png"
      ],
      "matches": [
        "https://*/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "synerixcode 1.0.0 — RS/AS",
